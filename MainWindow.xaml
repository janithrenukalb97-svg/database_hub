<Window x:Class="Database_Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Database_Hub"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        Title="Database Hub"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B0B6BE"/>
            <Setter Property="Foreground" Value="#23272F"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#818896"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6C7378"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#7D8285"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource MinimizeButtonStyle}">
            <Setter Property="BorderBrush" Value="#7A7A7A"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource MinimizeButtonStyle}">
            <Setter Property="Background" Value="#868787"/>
            <Setter Property="BorderBrush" Value="#9FA0A1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#F87171"/>
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowRootBorder" BorderBrush="#D0D7DE" BorderThickness="1" Background="#F5F5F5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#919191" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Database Hub"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MinimizeButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize" Content="−"/>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource MaximizeButtonStyle}" Click="MaximizeRestoreButton_Click" ToolTip="Maximize or Restore" Content="□"/>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close" Foreground="White" Content="✕"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ContentControl prism:RegionManager.RegionName="MainRegion" />
            </Grid>
        </Grid>
    </Border>
</Window>
