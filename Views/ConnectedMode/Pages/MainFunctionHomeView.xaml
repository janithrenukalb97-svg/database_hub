<UserControl x:Class="Database_Hub.Views.ConnectedMode.Pages.MainFunctionHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Database_Hub.Views.ConnectedMode.Pages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="NavToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="None"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="6" />
            <Setter Property="ToolTipService.VerticalOffset" Value="0" />
            <Setter Property="ToolTipService.PlacementRectangle" Value="0,0,0,52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F6" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,16">
                        <Button DockPanel.Dock="Bottom"
                            Content="{Binding LogoutNavContent}"
                                Margin="0,10,0,0"
                                FontSize="24"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding LogoutCommand}"
                                ToolTipService.Placement="Right"
                                ToolTipService.HorizontalOffset="10">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource NavToolTipStyle}" Content="Logout"/>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#D92D20" />
                                    <Setter Property="BorderBrush" Value="#D92D20" />
                                    <Setter Property="BorderThickness" Value="1.4" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FEE4E2" />
                                            <Setter Property="Foreground" Value="#B42318" />
                                            <Setter Property="BorderBrush" Value="#B42318" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <StackPanel>
            <Button Content="{Binding FileExplorerNavContent}"
                                Command="{Binding NavigateMenuCommand}"
                                CommandParameter="File Explorer">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource NavToolTipStyle}" Content="File Explorer"/>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileExplorerSelected}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB" />
                                            <Setter Property="Foreground" Value="#0F172A" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding ObjectExplorerNavContent}"
                                Command="{Binding NavigateMenuCommand}"
                                CommandParameter="Object Explorer">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource NavToolTipStyle}" Content="Object Explorer"/>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsObjectExplorerSelected}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB" />
                                            <Setter Property="Foreground" Value="#0F172A" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding ReleaseExecutorNavContent}"
                                Command="{Binding NavigateMenuCommand}"
                                CommandParameter="Release Executor">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource NavToolTipStyle}" Content="Release Executor"/>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReleaseExecutorSelected}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB" />
                                            <Setter Property="Foreground" Value="#0F172A" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding ComparisonToolNavContent}"
                                Command="{Binding NavigateMenuCommand}"
                                CommandParameter="Comparison Tool">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource NavToolTipStyle}" Content="Comparison Tool"/>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsComparisonToolSelected}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB" />
                                            <Setter Property="Foreground" Value="#0F172A" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <local:FileExplorerView
                        DataContext="{Binding FileExplorerViewModel}"
                        Visibility="{Binding DataContext.IsFileExplorerSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <local:ObjectExplorerView
                        DataContext="{Binding ObjectExplorerViewModel}"
                        Visibility="{Binding DataContext.IsObjectExplorerSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <local:ReleaseExecutorView
                        DataContext="{Binding ReleaseExecutorViewModel}"
                        Visibility="{Binding DataContext.IsReleaseExecutorSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <local:ComparisonToolView
                        DataContext="{Binding ComparisonToolViewModel}"
                        Visibility="{Binding DataContext.IsComparisonToolSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>
    </Grid>
</UserControl>
