<UserControl x:Class="Database_Hub.Views.ConnectedMode.Pages.MainFunctionHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Database_Hub.Views.ConnectedMode.Pages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F5F5">
        <DockPanel>
            <!-- Header with connection info -->
            <Border DockPanel.Dock="Top" Background="#107C10" Padding="10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔗 Connected Mode" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="{Binding ServerName}" FontSize="14" Foreground="White" VerticalAlignment="Center" Opacity="0.9"/>
                    </StackPanel>

                    <Button Width="120"
                            Height="40"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="White"
                            FontSize="15"
                            Command="{Binding LogoutCommand}">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="15"
                                        Padding="5">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <!-- Text -->
                                        <TextBlock Text="Logout"
                                                Foreground="{TemplateBinding Foreground}"
                                                VerticalAlignment="Center"/>
                                        <!-- Space -->
                                        <TextBlock Width="6"/>
                                        <!-- Icon -->
                                        <TextBlock Text="➜]"
                                                FontSize="16"
                                                Foreground="{TemplateBinding Foreground}"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <!-- Main Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" DockPanel.Dock="Bottom">
                <TextBlock Text="Main Function Home" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                <TextBlock Text="This is the main function home page for connected mode." FontSize="16"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
