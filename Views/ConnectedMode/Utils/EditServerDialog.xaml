<Window x:Class="Database_Hub.Views.ConnectedMode.EditServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Server"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border CornerRadius="16" BorderBrush="#E6E9EF" BorderThickness="1" Background="White">
        <Grid MinWidth="460" MaxWidth="760">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#7C2D12" CornerRadius="16,16,0,0" Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Edit Server" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Display Name" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,6"/>
                <Border Grid.Row="1" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" Padding="10,4" Margin="0,0,0,12">
                    <TextBox x:Name="txtName" Height="30" FontSize="16" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="2" Text="Server Address (e.g. SQLNPROD01A\\SQLIDEV,30401)" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,6"/>
                <Border Grid.Row="3" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" Padding="10,4">
                    <TextBox x:Name="txtAddress" Height="30" FontSize="16" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,14">
                <Button Content="Cancel"
                        Width="96"
                        Height="34"
                        Click="BtnCancel_Click"
                        Background="#475467"
                        Foreground="White"
                        BorderBrush="#475467"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Update"
                        Width="96"
                        Height="34"
                        Click="BtnOk_Click"
                        Background="#B54708"
                        Foreground="White"
                        BorderBrush="#B54708"
                        BorderThickness="1"
                        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
