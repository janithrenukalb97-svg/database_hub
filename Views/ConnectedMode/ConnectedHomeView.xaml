<UserControl x:Class="Database_Hub.Views.ConnectedMode.ConnectedHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Database_Hub.Views.ConnectedMode"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔗 Connected Mode" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Welcome to Database Hub" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding WelcomeMessage}" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#666666" TextWrapping="Wrap" MaxWidth="500"/>
                
                <!-- Full Features Info -->
                <Border Background="White" CornerRadius="10" Margin="20" Padding="20" MaxWidth="600">
                    <StackPanel>
                        <TextBlock Text="Available Features:" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBlock Text="✓ Database Connection Management" Margin="0,5" Foreground="#107C10" FontWeight="Bold"/>
                        <TextBlock Text="✓ Version Control Integration (Azure TFS)" Margin="0,5" Foreground="#107C10" FontWeight="Bold"/>
                        <TextBlock Text="✓ Script Comparison Tool" Margin="0,5"/>
                        <TextBlock Text="✓ Database Object Search and Preview" Margin="0,5"/>
                        <TextBlock Text="✓ File System Integration" Margin="0,5"/>
                        <TextBlock Text="✓ Script Execution and Logging" Margin="0,5"/>
                        <TextBlock Text="✓ Team Member Tracking" Margin="0,15,0,0" Foreground="#666666" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Button Width="150"
                        Height="40"
                        HorizontalAlignment="Center"
                        Background="#107C10"
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="White"
                        FontSize="15"
                        Command="{Binding NavigateMainFunctionCommand}">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15"
                                    Padding="5">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- Text -->
                                    <TextBlock Text="Continue"
                                            Foreground="{TemplateBinding Foreground}"
                                            VerticalAlignment="Center"/>
                                    <!-- Space -->
                                    <TextBlock Width="6"/>
                                    <!-- Icon -->
                                    <TextBlock Text="➜"
                                            FontSize="16"
                                            Foreground="{TemplateBinding Foreground}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
        </StackPanel>
    </Grid>
</UserControl>